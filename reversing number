import java.util.Scanner;
class Main {
    public static void main(String[] args) {
        Scanner s=new Scanner(System.in);
        int a,rev=0;
       System.out.println("enter a number: ");
        a=s.nextInt();
        while(a!=0)
        {
            int digit=a%10;
            rev=rev*10+digit;
            a=a/10;
            
        }
         System.out.println("revesed number is"+rev);
    }       
}
